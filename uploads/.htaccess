# Uploaded files are data, never application code.
Options -Indexes -ExecCGI
<FilesMatch "(?i)\.(?:php[0-9]*|phtml|phar|cgi|pl|py|shtml)(?:\.|$)">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "sandbox; default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'"
</IfModule>
